{
  "name": "gd-arena",
  "version": "0.1.0",
  "private": true,
  "description": "GD Arena - a 1v1 fighting game with a 3D arena and 2D fighters built from alliance members' pictures. Ships as a single web page.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.js",
    "lint": "eslint .",
    "test": "eslint . && node --test \"tests/*.test.js\"",
    "build:web": "node scripts/build.js web"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0"
  }
}
